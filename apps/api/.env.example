# Copy to .env for local overrides. Every value below is the default, so an
# empty .env behaves identically to no .env at all.

PORT=4000

# Comma-separated allowlist, or * for any origin (development only).
CORS_ORIGIN=http://localhost:3000

# The planner runs Gemini. Two ways in, and with neither set the query bar is
# answered by the built-in keyword parser — the app is fully functional that way.
#
# 1. Vertex AI. No API key: authentication is Google Application Default
#    Credentials, which is the Cloud Run runtime service account in production
#    and `gcloud auth application-default login` locally.
#    Only `global` and `us-central1` carry the current Gemini models.
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_REGION=us-central1

# 2. AI Studio (aistudio.google.com). Has a free tier and needs no GCP project.
#    Takes precedence over the Vertex settings above when both are present.
# GEMINI_API_KEY=...

# Flash keeps the query bar responsive; -lite is cheaper again.
# GEMINI_MODEL=gemini-2.5-flash

# Simulated upstream latency. Set both to 0 for a snappier local experience;
# the defaults exist so loading states are actually visible while developing.
UPSTREAM_LATENCY_MIN_MS=8
UPSTREAM_LATENCY_MAX_MS=45

# Fraction of requests where the budget/pacing upstream fails, exercising the
# degraded-data banner. Set to 0 if you are demoing.
BUDGET_SERVICE_FAILURE_RATE=0.06

# Last day of the generated 90-day window. Read by `npm run seed`, not by the
# server. Defaults to today (UTC); pin it for reproducible fixtures.
# SEED_END_DATE=2026-08-04
