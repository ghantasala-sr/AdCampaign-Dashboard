# Copy to .env for local overrides. Every value below is the default, so an
# empty .env behaves identically to no .env at all.

PORT=4000

# Comma-separated allowlist, or * for any origin (development only).
CORS_ORIGIN=http://localhost:3000

# Unset means the natural-language query bar is answered by the built-in keyword
# parser. The app is fully functional without a key; set this to route planning
# through claude-opus-5 instead.
# ANTHROPIC_API_KEY=sk-ant-...

# Simulated upstream latency. Set both to 0 for a snappier local experience;
# the defaults exist so loading states are actually visible while developing.
UPSTREAM_LATENCY_MIN_MS=8
UPSTREAM_LATENCY_MAX_MS=45

# Fraction of requests where the budget/pacing upstream fails, exercising the
# degraded-data banner. Set to 0 if you are demoing.
BUDGET_SERVICE_FAILURE_RATE=0.06

# Last day of the generated 90-day window. Read by `npm run seed`, not by the
# server. Defaults to today (UTC); pin it for reproducible fixtures.
# SEED_END_DATE=2026-08-04
