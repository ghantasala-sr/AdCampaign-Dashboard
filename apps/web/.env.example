# Copy to .env.local for local overrides.

# Base URL of the BFF.
#
# NEXT_PUBLIC_* values are inlined at build time, not read at runtime — setting
# this on a deployed host after building has no effect. It must be present when
# `next build` runs. See DEPLOY.md.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Set to 1 to build the un-optimized baseline variant used by
# `npm run measure:bundle`. Not for normal development.
# NEXT_PUBLIC_PERF_BASELINE=0
