{
  "name": "adsight",
  "private": true,
  "version": "0.1.0",
  "description": "Ad campaign performance dashboard — Turborepo monorepo (Next.js web + Express BFF)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "seed": "npm run seed --workspace=@adsight/api",
    "e2e": "npm run e2e --workspace=@adsight/web",
    "perf": "npm run perf --workspace=@adsight/web",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
